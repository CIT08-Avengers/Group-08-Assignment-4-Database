import { pool } from './db.js';

// part A
const STUDENT_COLS = `id, name, dept_name AS "deptName", tot_cred::int AS "totCred"`;

export async function listStudents(limit: number, offset: number): Promise<Student[]> {
  const result = await pool.query(
    `SELECT ${STUDENT_COLS} FROM student ORDER BY id LIMIT $1 OFFSET $2`,
    [limit, offset],
  );
  return result.rows;
}

export async function findStudent(id: string): Promise<Student | undefined> {
  const result = await pool.query(
    `SELECT ${STUDENT_COLS} FROM student WHERE id = $1`,
    [id],
  );
  return result.rows[0]; ] 
}

export async function studentsIn(deptName: string): Promise<Student[]> {
  const result = await pool.query(
    `SELECT ${STUDENT_COLS} FROM student WHERE dept_name = $1 ORDER BY name`,
    [deptName],
  );
  return result.rows;
}

export async function coursesFor(studentId: string): Promise<CourseRow[]> {
  const result = await pool.query(
    `SELECT c.course_id AS "courseId", c.title, danish_grade(t.grade) AS grade
       FROM takes t
       JOIN course c ON c.course_id = t.course_id
      WHERE t.id = $1
      ORDER BY c.course_id`,
    [studentId],
  );
  return result.rows;
}

export async function studentsPerDepartment(): Promise<DeptCount[]> {
  const result = await pool.query(
    `SELECT d.dept_name AS "deptName", count(s.id)::int AS students
       FROM department d
       LEFT JOIN student s ON s.dept_name = d.dept_name
      GROUP BY d.dept_name
      ORDER BY d.dept_name`,
  );
  return result.rows;
}

export async function insertStudent(student: Student): Promise<Student> {
  const result = await pool.query(
    `INSERT INTO student (id, name, dept_name, tot_cred)
     VALUES ($1, $2, $3, $4)
     RETURNING ${STUDENT_COLS}`,
    [student.id, student.name, student.deptName, student.totCred],
  );
  return result.rows[0];
}

export async function deleteStudent(id: string): Promise<boolean> {
  const result = await pool.query(`DELETE FROM student WHERE id = $1`, [id]);
  return (result.rowCount ?? 0) > 0; 
}

// Part B1

export async function enrolInTypeScript(input: EnrolInput): Promise<number> {
  const { studentId, courseId, secId, semester, year } = input;
  const client = await pool.connect(); // a transaction needs ONE connection
  try {
    await client.query('BEGIN');
    await client.query(
      `INSERT INTO takes (id, course_id, sec_id, semester, year)
       VALUES ($1, $2, $3, $4, $5)`,
      [studentId, courseId, secId, semester, year],
    );
    const result = await client.query(
      `UPDATE student
          SET tot_cred = tot_cred + (SELECT credits FROM course WHERE course_id = $2)
        WHERE id = $1
        RETURNING tot_cred::int AS "totCred"`,
      [studentId, courseId],
    );
    await client.query('COMMIT');
    return result.rows[0].totCred;
  } catch (err) {
    await client.query('ROLLBACK');
    throw err;
  } finally {
    client.release(); 
  }
}
